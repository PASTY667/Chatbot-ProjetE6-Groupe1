generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auth_session {
  id_auth_session BigInt          @id @default(autoincrement())
  id_user         Int
  session_uid     String          @unique(map: "uk_auth_session_uid") @db.Char(36)
  user_agent      String?         @db.VarChar(255)
  ip_address      String?         @db.VarChar(50)
  created_at      DateTime        @db.DateTime(0)
  expires_at      DateTime        @db.DateTime(0)
  revoked_at      DateTime?       @db.DateTime(0)
  user            user            @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_auth_session_user")
  refresh_token   refresh_token[]

  @@index([id_user], map: "idx_auth_session_user")
}

model demarrer {
  id_user    Int
  id_session Int
  id_message Int
  message    message @relation(fields: [id_message], references: [id_message], onDelete: NoAction, onUpdate: NoAction, map: "demarrer_id_message_FK")
  session    session @relation(fields: [id_session], references: [id_session], onDelete: NoAction, onUpdate: NoAction, map: "demarrer_id_session_FK")
  user       user    @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "demarrer_id_user_FK")

  @@id([id_user, id_session, id_message])
  @@index([id_message], map: "demarrer_id_message_FK")
  @@index([id_session], map: "demarrer_id_session_FK")
}

model deposer {
  id_file    Int
  id_message Int
  id_user    Int
  file       file    @relation(fields: [id_file], references: [id_file], onDelete: NoAction, onUpdate: NoAction, map: "deposer_id_file_FK")
  message    message @relation(fields: [id_message], references: [id_message], onDelete: NoAction, onUpdate: NoAction, map: "deposer_id_message_FK")
  user       user    @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "deposer_id_user_FK")

  @@id([id_file, id_message, id_user])
  @@index([id_message], map: "deposer_id_message_FK")
  @@index([id_user], map: "deposer_id_user_FK")
}

model file {
  id_file         Int               @id @default(autoincrement())
  filename        String            @db.VarChar(100)
  date            DateTime          @db.DateTime(0)
  deposer         deposer[]
  vector_document vector_document[]
}

model jwt_denylist {
  id_deny    BigInt   @id @default(autoincrement())
  jti        String   @unique(map: "uk_jti") @db.Char(36)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)

  @@index([expires_at], map: "idx_jti_exp")
}

model log {
  id_log     Int      @id @default(autoincrement())
  date       DateTime @db.DateTime(0)
  ip_address String   @db.VarChar(50)
  state      Boolean
  id_user    Int
  user       user     @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "log_id_user_FK")

  @@index([id_user], map: "log_id_user_FK")
}

model message {
  id_message Int        @id @default(autoincrement())
  content    String     @db.VarChar(4000)
  date       DateTime   @db.DateTime(0)
  sender     String     @db.VarChar(50)
  id_session Int
  demarrer   demarrer[]
  deposer    deposer[]
  session    session    @relation(fields: [id_session], references: [id_session], onDelete: NoAction, onUpdate: NoAction, map: "message_id_session_FK")

  @@index([id_session], map: "message_id_session_FK")
}

model refresh_token {
  id_refresh      BigInt       @id @default(autoincrement())
  id_auth_session BigInt
  token_hash      String       @unique(map: "uk_refresh_hash") @db.Char(64)
  created_at      DateTime     @db.DateTime(0)
  expires_at      DateTime     @db.DateTime(0)
  revoked_at      DateTime?    @db.DateTime(0)
  replaced_by     BigInt?
  auth_session    auth_session @relation(fields: [id_auth_session], references: [id_auth_session], onDelete: NoAction, onUpdate: NoAction, map: "fk_refresh_session")

  @@index([id_auth_session], map: "idx_refresh_session")
}

model session {
  id_session      Int               @id @default(autoincrement())
  name            String            @db.VarChar(50)
  last_updated    DateTime          @db.DateTime(0)
  created_at      DateTime          @db.DateTime(0)
  demarrer        demarrer[]
  message         message[]
  vector_document vector_document[]
}

model user {
  id_user         Int               @id @default(autoincrement())
  id_LDAP         String            @db.VarChar(50)
  admin           Boolean
  enabled         Boolean
  nbr_connexion   Int
  nbr_requete     Int
  nbr_doc_sent    Int
  auth_session    auth_session[]
  demarrer        demarrer[]
  deposer         deposer[]
  log             log[]
  vector_document vector_document[]
}

model vector_document {
  id_vector_doc    BigInt                @id @default(autoincrement())
  id_file          Int
  id_user          Int
  id_session       Int?
  scope            vector_document_scope
  collection_name  String                @db.VarChar(120)
  doc_id           String                @db.VarChar(120)
  chroma_ids_count Int                   @default(0)
  created_at       DateTime              @db.DateTime(0)
  expires_at       DateTime?             @db.DateTime(0)
  deleted_at       DateTime?             @db.DateTime(0)
  file             file                  @relation(fields: [id_file], references: [id_file], onDelete: NoAction, onUpdate: NoAction, map: "fk_vector_file")
  session          session?              @relation(fields: [id_session], references: [id_session], onDelete: NoAction, onUpdate: NoAction, map: "fk_vector_session")
  user             user                  @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction, map: "fk_vector_user")

  @@index([id_file], map: "fk_vector_file")
  @@index([collection_name, doc_id], map: "idx_vector_collection_doc")
  @@index([scope], map: "idx_vector_scope")
  @@index([id_session], map: "idx_vector_session")
  @@index([id_user], map: "idx_vector_user")
}

enum vector_document_scope {
  company
  user_session
}
